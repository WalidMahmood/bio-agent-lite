# BioAgent-Lite Configuration Environment Variables

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Local Inference LLM Server (llama-server OpenAI-compatible endpoint)
LLM_SERVER_ENDPOINT=http://127.0.0.1:8080
DEFAULT_MODEL=gemma-3-4b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=300

# Edge Hardware Constraints (Laptop RTX 5050 / 8GB VRAM)
VRAM_BUDGET_GB=8.0
CONTEXT_WINDOW_TOKENS=8192

# Data and Storage Paths
DATA_DIR=./data
OUTPUTS_DIR=./outputs
TABLES_DIR=./outputs/tables
FIGURES_DIR=./outputs/figures
REPORTS_DIR=./outputs/reports
TRACES_DIR=./outputs/traces
UPLOAD_DIR=./data/uploads

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./chroma_data
